<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="E_FanucCstopiState" Id="{c3d4e5f6-a7b8-9012-cdef-012345678902}">
    <Declaration><![CDATA[// States used by FB_FanucCycleStop.

TYPE E_FanucCstopiState :
(
	Idle	:= 0, // Waits for a rising edge of bStart.
	Pulsing	:= 1, // Generates the CSTOPI pulse for tCycleStopPulse.
	Done	:= 2 // Sets bDone for one PLC scan to confirm pulse completion, then returns to Idle.
);
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>