<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="E_FanucEnableState" Id="{80168690-038f-d713-beb2-b94b9c563a4c}">
    <Declaration><![CDATA[// States used by FB_FanucEnable.

TYPE E_FanucEnableState :
(
	Idle			:= 0, // ENBL is FALSE; waits for all enable permissives and bExtStart = FALSE.
	ClearFault		:= 1, // Waits for bFault = FALSE; this state does not generate FAULT_RESET.
	CheckTP			:= 3, // Waits for bTP_Enabled = FALSE before proceeding to WaitReady.
	WaitReady		:= 4, // Waits for bCmd_Enabled AND bSystem_Ready within tReadyTimeout.
	Ready			:= 5, // Sets bReady and accepts START edges while monitoring faults and interlocks.
	Paused			:= 6, // Waits for bExtHold = TRUE and bMotion_Held = FALSE before returning to Ready.
	EmergencyStop	:= 7, // Waits for bExtIMSTP = TRUE before returning through ClearFault.
	SafeSpeed		:= 8, // Waits for bExtSFSPD = TRUE before returning to Ready or Paused.
	Error			:= 99 // Sets bError and removes ENBL; bEnable = FALSE returns to Idle.
);
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>