<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="E_FanucStartProgramState" Id="{e5f6a7b8-c9d0-1234-ef01-234567890abc}">
    <Declaration><![CDATA[(*
  States for FB_FanucStartProgram.
  Sequence: Idle → Pulsing → Done (→ Idle)
  Error on invalid program number; reset by setting bStart FALSE.
*)
TYPE E_FanucStartProgramState :
(
	Idle       := 0,   // Waiting for Start rising edge
    Pulsing    := 1,   // Selected RSR signal asserted
    WaitAck    := 2,   // Waiting for FANUC ACK
    Done       := 3,   // ACK received - one PLC scan
    Error      := 99   // Invalid program or ACK timeout
);
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>