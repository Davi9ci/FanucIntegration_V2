<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="E_FanucStartProgramState" Id="{e5f6a7b8-c9d0-1234-ef01-234567890abc}">
    <Declaration><![CDATA[// States used by FB_FanucStartProgram.

TYPE E_FanucStartProgramState :
(
	Idle	:= 0, // Waits for a rising edge of bStart while bReady = TRUE, then validates nProgram.
	Pulsing	:= 1, // Generates the selected RSR pulse for tProgramPulse and monitors its ACK.
	WaitAck	:= 2, // Waits for a fresh matching ACK within tAckTimeout after the pulse.
	Done	:= 3, // Sets bDone for one PLC scan to confirm acknowledgement, then returns to Idle.
	Error	:= 99 // Sets bError; bStart = FALSE returns to Idle.
);
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>