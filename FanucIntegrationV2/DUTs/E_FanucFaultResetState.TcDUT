<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="E_FanucFaultResetState" Id="{9016ccc7-d5a8-3a1b-bdec-5f74d6e91223}">
    <Declaration><![CDATA[// States used by FB_FanucFaultReset.

TYPE E_FanucFaultResetState :
(
	Idle		:= 0, // Waits for a rising edge of bReset.
	SendPulse	:= 1, // Generates the FAULT_RESET pulse for tResetPulse.
	WaitClear	:= 2, // Waits for bFault = FALSE within tFaultTimeout after the pulse.
	Done		:= 3, // Sets bDone for one PLC scan, then returns to Idle.
	Error		:= 99 // Sets bError; bReset = FALSE returns to Idle.
);
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>