<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="E_FanucHomingState" Id="{a420d0f4-2149-0bfc-1973-4e8eeb137e39}">
    <Declaration><![CDATA[// States used by FB_FanucHoming.

TYPE E_FanucHomingState :
(
	Idle			:= 0, // Waits for a rising edge of bStart while bReady = TRUE.
	RequestHome		:= 1, // Generates the HOME pulse for tHomePulse while bReady remains TRUE.
	WaitComplete	:= 2, // Waits for bAt_Home = TRUE within tHomingTimeout while bReady remains TRUE.
	Done			:= 3, // Sets bDone for one PLC scan, then returns to Idle.
	Error			:= 99 // Sets bError; bStart = FALSE returns to Idle.
);
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>