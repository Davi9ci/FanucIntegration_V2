<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_FanucSpeedOverride" Id="{7fe993ee-da03-4a39-824e-7c02eccb23c1}" SpecialFunc="None">
    <Declaration><![CDATA[// Continuously writes the validated speed-override command.
// Values above 100 produce a 0% command and set bError.

FUNCTION_BLOCK FB_FanucSpeedOverride

VAR_INPUT
	nOverwrite	: BYTE; // Requested speed override in percent; valid range: 0..100.
END_VAR

VAR_IN_OUT
	stControl	: ST_FanucControl; // Shared FANUC control structure; this FB writes Overwrite only.
END_VAR

VAR_OUTPUT
	bError	: BOOL; // TRUE while nOverwrite exceeds cMaxOverwrite; clears when the input becomes valid.
	nActual	: BYTE; // Override command written to stControl.Overwrite; not robot feedback. Invalid input produces 0.
END_VAR

VAR CONSTANT
	cMaxOverwrite	: BYTE := 100; // Maximum accepted speed-override command in percent.
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// Input validation
// ============================================================================
bError := nOverwrite > cMaxOverwrite;

// Determine actual output value
// ============================================================================
// An invalid value results in 0% override.
//
// This keeps the result deterministic and prevents an invalid command
// from leaving the previous overwrite value active.

IF bError THEN
    nActual := 0;
ELSE
    nActual := nOverwrite;
END_IF;


// FANUC control output
// ============================================================================
// Continuously write the validated overwrite value to the shared
// FANUC control structure.

stControl.Override := nActual;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>