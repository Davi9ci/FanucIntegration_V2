<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_FanucFaultReset" Id="{daeb7cee-3c71-0abb-a37b-b222806c74f1}" SpecialFunc="None">
    <Declaration><![CDATA[// Sends a FAULT_RESET pulse to the FANUC robot and waits for
// the active fault indication to clear.
//
// A rising edge of bReset generates a FAULT_RESET pulse for
// tResetPulse. After the pulse, the FB waits for bFault to become
// FALSE. If the fault remains active longer than tFaultTimeout,
// the FB enters Error.

FUNCTION_BLOCK FB_FanucFaultReset

VAR_INPUT
    // External fault-reset request.
    // Only a real FALSE -> TRUE edge is accepted.
    bReset : BOOL;

    // Live robot status from FB_FanucStatus.
    stStatus : ST_FanucStatus;

    // Maximum time to wait for the FANUC fault indication to clear
    // after the FAULT_RESET pulse has completed.
    tFaultTimeout : TIME := T#5S;
END_VAR

VAR_IN_OUT
    // Shared FANUC control structure.
    stControl : ST_FanucControl;
END_VAR

VAR_OUTPUT
    // TRUE while transmitting FAULT_RESET or waiting for bFault to clear.
    bBusy : BOOL;

    // TRUE for one PLC scan after the fault is confirmed cleared.
    bDone : BOOL;

    // TRUE when the fault did not clear within tFaultTimeout.
    // Reset by releasing bReset.
    bError : BOOL;

    // Current state for diagnostics / HMI.
    eState : E_FanucFaultResetState;
END_VAR

VAR
    // Internal state.
    eCurrentState : E_FanucFaultResetState :=
        E_FanucFaultResetState.Idle;

    // Detect the actual FALSE -> TRUE transition.
    rtReset : R_TRIG;

    // FAULT_RESET output pulse timer.
    tonResetPulse : TON;

    // Timeout while waiting for bFault to clear.
    tonFaultTimeout : TON;
END_VAR

VAR CONSTANT
    // FANUC FAULT_RESET pulse duration.
    tResetPulse : TIME := T#20MS;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// Reset edge detection
// ============================================================================
rtReset(CLK := bReset);

// State machine
// ============================================================================
CASE eCurrentState OF

    // IDLE
    // ========================================================================
    E_FanucFaultResetState.Idle:

        IF rtReset.Q THEN
            eCurrentState := E_FanucFaultResetState.SendPulse;
        END_IF;

    // SEND RESET PULSE
    // ========================================================================
    E_FanucFaultResetState.SendPulse:

        // Always complete the configured FAULT_RESET pulse.
        IF tonResetPulse.Q THEN

            // The fault may already have cleared during the pulse.
            IF NOT stStatus.bFault THEN
                eCurrentState := E_FanucFaultResetState.Done;
            ELSE
                eCurrentState := E_FanucFaultResetState.WaitClear;
            END_IF;

        END_IF;

    // WAIT FOR FAULT TO CLEAR
    // ========================================================================
    E_FanucFaultResetState.WaitClear:

        IF NOT stStatus.bFault THEN
            eCurrentState := E_FanucFaultResetState.Done;

        ELSIF tonFaultTimeout.Q THEN
            eCurrentState := E_FanucFaultResetState.Error;
        END_IF;

    // DONE
    // ========================================================================
    E_FanucFaultResetState.Done:

        // bDone is exposed for one PLC scan.
        eCurrentState := E_FanucFaultResetState.Idle;

    // ERROR
    // ========================================================================
    E_FanucFaultResetState.Error:

        // Require the reset request to be released before another attempt.
        IF NOT bReset THEN
            eCurrentState := E_FanucFaultResetState.Idle;
        END_IF;

    // INVALID / UNKNOWN STATE
    ELSE

        eCurrentState := E_FanucFaultResetState.Error;

END_CASE;

// Timers
// ============================================================================
// Each timer is called exactly once per PLC scan and is enabled only by
// its corresponding state.
tonResetPulse(
    IN := (eCurrentState = E_FanucFaultResetState.SendPulse),
    PT := tResetPulse
);

tonFaultTimeout(
    IN := (eCurrentState = E_FanucFaultResetState.WaitClear),
    PT := tFaultTimeout
);


// FANUC control output
// ============================================================================
// FAULT_RESET is asserted only while the pulse is active.
stControl.Fault_Reset := (eCurrentState = E_FanucFaultResetState.SendPulse) AND NOT tonResetPulse.Q;

// Diagnostic outputs
// ============================================================================
eState := eCurrentState;
bBusy := (eCurrentState = E_FanucFaultResetState.SendPulse) OR (eCurrentState = E_FanucFaultResetState.WaitClear);
bDone := (eCurrentState = E_FanucFaultResetState.Done);
bError := (eCurrentState = E_FanucFaultResetState.Error);]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>