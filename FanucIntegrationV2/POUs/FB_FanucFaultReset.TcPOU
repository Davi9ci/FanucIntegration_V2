<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_FanucFaultReset" Id="{daeb7cee-3c71-0abb-a37b-b222806c74f1}" SpecialFunc="None">
    <Declaration><![CDATA[// Pulses FAULT_RESET and confirms that the FANUC fault indication is FALSE.
// Call every PLC scan.

FUNCTION_BLOCK FB_FanucFaultReset

VAR_INPUT
	bReset			: BOOL; // Rising edge starts a reset request while Idle; FALSE clears the FB error.
	stStatus		: ST_FanucStatus; // Live robot-status signals from FB_FanucStatus.
	tFaultTimeout	: TIME := T#5S; // Maximum wait for bFault = FALSE after the reset pulse completes.
END_VAR

VAR_IN_OUT
	stControl : ST_FanucControl; // Shared FANUC control structure; this FB writes Fault_Reset only.
END_VAR

VAR_OUTPUT
	bBusy	: BOOL; // TRUE while in SendPulse or WaitClear.
	bDone	: BOOL; // TRUE for one PLC scan when the pulse is complete and bFault is FALSE.
	bError	: BOOL; // TRUE in Error after a fault-clear timeout or invalid state; cleared by bReset = FALSE.
	eState	: E_FanucFaultResetState; // Current state exposed for diagnostics and HMI.
END_VAR

VAR
	eCurrentState	: E_FanucFaultResetState := E_FanucFaultResetState.Idle; // Internal state used by the sequence.
	rtReset			: R_TRIG; // Detects the FALSE-to-TRUE transition of bReset.
	tonResetPulse	: TON; // Measures the FAULT_RESET pulse duration in SendPulse.
	tonFaultTimeout	: TON; // Measures the wait for bFault = FALSE in WaitClear.
END_VAR

VAR CONSTANT
	tResetPulse	: TIME := T#20MS; // Requested duration of the FAULT_RESET output pulse on UI[5].
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// Reset edge detection
// ============================================================================
rtReset(CLK := bReset);

// State machine
// ============================================================================
CASE eCurrentState OF

    // IDLE
    // ========================================================================
    E_FanucFaultResetState.Idle:

        IF rtReset.Q THEN
            eCurrentState := E_FanucFaultResetState.SendPulse;
        END_IF;

    // SEND RESET PULSE
    // ========================================================================
    E_FanucFaultResetState.SendPulse:

        // Always complete the configured FAULT_RESET pulse.
        IF tonResetPulse.Q THEN

            // The fault may already have cleared during the pulse.
            IF NOT stStatus.bFault THEN
                eCurrentState := E_FanucFaultResetState.Done;
            ELSE
                eCurrentState := E_FanucFaultResetState.WaitClear;
            END_IF;

        END_IF;

    // WAIT FOR FAULT TO CLEAR
    // ========================================================================
    E_FanucFaultResetState.WaitClear:

        IF NOT stStatus.bFault THEN
            eCurrentState := E_FanucFaultResetState.Done;

        ELSIF tonFaultTimeout.Q THEN
            eCurrentState := E_FanucFaultResetState.Error;
        END_IF;

    // DONE
    // ========================================================================
    E_FanucFaultResetState.Done:

        // bDone is exposed for one PLC scan.
        eCurrentState := E_FanucFaultResetState.Idle;

    // ERROR
    // ========================================================================
    E_FanucFaultResetState.Error:

        // Require the reset request to be released before another attempt.
        IF NOT bReset THEN
            eCurrentState := E_FanucFaultResetState.Idle;
        END_IF;

    // INVALID / UNKNOWN STATE
    ELSE

        eCurrentState := E_FanucFaultResetState.Error;

END_CASE;

// Timers
// ============================================================================
// Each timer is called exactly once per PLC scan and is enabled only by
// its corresponding state.
tonResetPulse(
    IN := (eCurrentState = E_FanucFaultResetState.SendPulse),
    PT := tResetPulse
);

tonFaultTimeout(
    IN := (eCurrentState = E_FanucFaultResetState.WaitClear),
    PT := tFaultTimeout
);


// FANUC control output
// ============================================================================
// FAULT_RESET is asserted only while the pulse is active.
stControl.Fault_Reset := (eCurrentState = E_FanucFaultResetState.SendPulse) AND NOT tonResetPulse.Q;

// Diagnostic outputs
// ============================================================================
eState := eCurrentState;
bBusy := (eCurrentState = E_FanucFaultResetState.SendPulse) OR (eCurrentState = E_FanucFaultResetState.WaitClear);
bDone := (eCurrentState = E_FanucFaultResetState.Done);
bError := (eCurrentState = E_FanucFaultResetState.Error);]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>