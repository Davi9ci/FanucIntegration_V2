<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_FanucStartProgram" Id="{639e9b5b-2378-78fc-0e0b-e22f6bfc1f16}" SpecialFunc="None">
    <Declaration><![CDATA[// Starts a FANUC program using RSR1..RSR8.
//
// A rising edge of bStart is accepted only while the robot is Ready.
// The selected RSR signal is pulsed for tProgramPulse.
// Completion is confirmed by the corresponding FANUC ACK signal.
//
// If robot Ready is lost during the sequence, the FB returns to Idle.

FUNCTION_BLOCK FB_FanucStartProgram

VAR_INPUT
    // External program-start request.
    // Only a rising edge occurring while bReady = TRUE is accepted.
    bStart : BOOL;

    // RSR program number: 1..8.
    nProgram : INT;

    // Robot ready indication from FB_FanucEnable.
    bReady : BOOL;

    // Maximum time allowed for FANUC to acknowledge the program request.
    tAckTimeout : TIME := T#2S;

    // Live robot status from FB_FanucStatus.
    stStatus : ST_FanucStatus;
END_VAR

VAR_IN_OUT
    // Shared FANUC control structure.
    stControl : ST_FanucControl;
END_VAR

VAR_OUTPUT
    // TRUE while program-start sequence is active.
    bBusy : BOOL;

    // TRUE for one PLC scan when FANUC acknowledges the request.
    bDone : BOOL;

    // TRUE on invalid program number or ACK timeout.
    bError : BOOL;

    // Current state for diagnostics / HMI.
    eState : E_FanucStartProgramState;
END_VAR

VAR
    eCurrentState : E_FanucStartProgramState :=
        E_FanucStartProgramState.Idle;

    // Detect actual external FALSE -> TRUE transition.
    rtStart : R_TRIG;

    // Program number latched when request is accepted.
    nActiveProgram : INT;

    // Selected ACK feedback.
    bActiveAck : BOOL;

    // RSR output pulse timer.
    tonProgramPulse : TON;

    // Timeout waiting for FANUC ACK.
    tonAckTimeout : TON;
END_VAR

VAR CONSTANT
    // FANUC RSR command pulse duration.
    tProgramPulse : TIME := T#200MS;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// Start edge detection
// ============================================================================
//
// Detect the actual external FALSE -> TRUE transition.
// Do NOT gate R_TRIG with bReady.
//
rtStart(CLK := bStart);


// Selected ACK
// ============================================================================
//
// Select the ACK corresponding to the latched RSR program.
CASE nActiveProgram OF
    1: bActiveAck := stStatus.bProg_Start1ACK;
    2: bActiveAck := stStatus.bProg_Start2ACK;
    3: bActiveAck := stStatus.bProg_Start3ACK;
    4: bActiveAck := stStatus.bProg_Start4ACK;
    5: bActiveAck := stStatus.bProg_Start5ACK;
    6: bActiveAck := stStatus.bProg_Start6ACK;
    7: bActiveAck := stStatus.bProg_Start7ACK;
    8: bActiveAck := stStatus.bProg_Start8ACK;

ELSE
    bActiveAck := FALSE;
END_CASE;


// State machine
// ============================================================================

CASE eCurrentState OF

    // IDLE ====================================================================
    E_FanucStartProgramState.Idle:

        // Accept Start only if the rising edge occurs while robot is Ready.
        IF rtStart.Q AND bReady THEN

            // RSR supports programs 1..8.
            IF (nProgram < 1) OR (nProgram > 8) THEN

                eCurrentState := E_FanucStartProgramState.Error;

            ELSE

                // Latch the requested program so it cannot change
                // during the sequence.
                nActiveProgram := nProgram;

                eCurrentState := E_FanucStartProgramState.Pulsing;

            END_IF;

        END_IF;


    // PULSING =================================================================
    E_FanucStartProgramState.Pulsing:

        // Robot must remain Ready during the request.
        IF NOT bReady THEN

            eCurrentState := E_FanucStartProgramState.Idle;

        // FANUC may acknowledge before the 200 ms pulse has finished.
        ELSIF bActiveAck THEN

            eCurrentState := E_FanucStartProgramState.Done;

        // RSR pulse completed - now wait for ACK.
        ELSIF tonProgramPulse.Q THEN

            eCurrentState := E_FanucStartProgramState.WaitAck;

        END_IF;


    // WAIT ACK ================================================================
    E_FanucStartProgramState.WaitAck:

        // Abort the FB sequence if Ready is lost.
        IF NOT bReady THEN

            eCurrentState := E_FanucStartProgramState.Idle;

        // Matching FANUC ACK received.
        ELSIF bActiveAck THEN

            eCurrentState := E_FanucStartProgramState.Done;

        // FANUC failed to acknowledge the request.
        ELSIF tonAckTimeout.Q THEN

            eCurrentState := E_FanucStartProgramState.Error;

        END_IF;


    // DONE ====================================================================
    E_FanucStartProgramState.Done:

        // Done / Ack are exposed for one PLC scan.
        eCurrentState := E_FanucStartProgramState.Idle;


    // ERROR ===================================================================
    E_FanucStartProgramState.Error:

        // Require Start to be released before another attempt.
        IF NOT bStart THEN

            eCurrentState := E_FanucStartProgramState.Idle;

        END_IF;


    // INVALID / UNKNOWN STATE =================================================
    ELSE

        eCurrentState := E_FanucStartProgramState.Error;

END_CASE;


// Timers
// ============================================================================

tonProgramPulse(
    IN := (eCurrentState = E_FanucStartProgramState.Pulsing),
    PT := tProgramPulse
);

tonAckTimeout(
    IN := (eCurrentState = E_FanucStartProgramState.WaitAck),
    PT := tAckTimeout
);


// FANUC RSR outputs
// ============================================================================
//
// Default all RSR signals FALSE.
//
stControl.Start_Program1 := FALSE;
stControl.Start_Program2 := FALSE;
stControl.Start_Program3 := FALSE;
stControl.Start_Program4 := FALSE;
stControl.Start_Program5 := FALSE;
stControl.Start_Program6 := FALSE;
stControl.Start_Program7 := FALSE;
stControl.Start_Program8 := FALSE;


// Assert exactly one RSR signal while Pulsing.
//
IF (eCurrentState = E_FanucStartProgramState.Pulsing)
    AND NOT tonProgramPulse.Q THEN

    CASE nActiveProgram OF
        1: stControl.Start_Program1 := TRUE;
        2: stControl.Start_Program2 := TRUE;
        3: stControl.Start_Program3 := TRUE;
        4: stControl.Start_Program4 := TRUE;
        5: stControl.Start_Program5 := TRUE;
        6: stControl.Start_Program6 := TRUE;
        7: stControl.Start_Program7 := TRUE;
        8: stControl.Start_Program8 := TRUE;
    END_CASE;

END_IF;


// Diagnostic outputs
// ============================================================================

eState := eCurrentState;

bBusy := (eCurrentState = E_FanucStartProgramState.Pulsing) OR (eCurrentState = E_FanucStartProgramState.WaitAck);

bDone := (eCurrentState = E_FanucStartProgramState.Done);

bError := (eCurrentState = E_FanucStartProgramState.Error);]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>