<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_FanucStartProgram" Id="{639e9b5b-2378-78fc-0e0b-e22f6bfc1f16}" SpecialFunc="None">
    <Declaration><![CDATA[// Pulses the selected RSR signal and waits for a fresh matching acknowledgement.
// Loss of bReady returns the FB to Idle without confirming the request.

FUNCTION_BLOCK FB_FanucStartProgram

VAR_INPUT
	bStart		: BOOL; // Rising edge starts a request while Idle and bReady; FALSE clears the FB error.
	nProgram	: INT; // Requested RSR selection, 1..8; latched when a valid request is accepted.
	bReady		: BOOL; // Enable permissive from FB_FanucEnable; must remain TRUE throughout the sequence.
	tAckTimeout	: TIME := T#2S; // Maximum additional wait for acknowledgement after the RSR pulse completes.
	stStatus	: ST_FanucStatus; // Live robot-status signals from FB_FanucStatus.
END_VAR

VAR_IN_OUT
	stControl	: ST_FanucControl; // Shared FANUC control structure; this FB writes Start_Program1..8 only.
END_VAR

VAR_OUTPUT
	bRequestActive	: BOOL; // TRUE while in Pulsing or WaitAck; does not indicate program execution.
	bDone			: BOOL; // TRUE for one PLC scan after the pulse completes and a fresh matching ACK is detected.
	bError			: BOOL; // TRUE in Error after invalid selection, ACK timeout, or invalid state; cleared by bStart = FALSE.
	eState			: E_FanucStartProgramState; // Current state exposed for diagnostics and HMI.
END_VAR

VAR
	eCurrentState	: E_FanucStartProgramState := E_FanucStartProgramState.Idle; // Internal state used by the sequence.
	rtStart			: R_TRIG; // Detects the FALSE-to-TRUE transition of bStart.
	nActiveProgram	: INT; // Latched RSR selection used for the active output and matching ACK.
	bActiveAck		: BOOL; // Current acknowledgement signal corresponding to nActiveProgram.
	bAckArmed		: BOOL; // TRUE once the selected ACK has been observed FALSE during the active sequence.
	bAckSeen		: BOOL; // Latched TRUE when the selected ACK is TRUE after acknowledgement detection is armed.
	tonProgramPulse	: TON; // Measures the selected RSR pulse duration in Pulsing.
	tonAckTimeout	: TON; // Measures the additional acknowledgement wait in WaitAck.
END_VAR

VAR CONSTANT
	tProgramPulse : TIME := T#200MS; // Requested duration of the selected RSR output pulse on UI[9..16].
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// Start edge detection
// ============================================================================
rtStart(CLK := bStart);


// Selected ACK
// ============================================================================
//
// Select the acknowledgement corresponding to the latched program.
CASE nActiveProgram OF

    1: bActiveAck := stStatus.bProg_Start1ACK;
    2: bActiveAck := stStatus.bProg_Start2ACK;
    3: bActiveAck := stStatus.bProg_Start3ACK;
    4: bActiveAck := stStatus.bProg_Start4ACK;
    5: bActiveAck := stStatus.bProg_Start5ACK;
    6: bActiveAck := stStatus.bProg_Start6ACK;
    7: bActiveAck := stStatus.bProg_Start7ACK;
    8: bActiveAck := stStatus.bProg_Start8ACK;

ELSE

    bActiveAck := FALSE;

END_CASE;


// ACK detection
// ============================================================================

IF (eCurrentState = E_FanucStartProgramState.Pulsing) OR (eCurrentState = E_FanucStartProgramState.WaitAck) THEN

    // Arm acknowledgement detection once ACK is LOW.
    IF NOT bActiveAck THEN

        bAckArmed := TRUE;

    END_IF;

    // Once armed, ACK becoming TRUE confirms the request.
    IF bAckArmed AND bActiveAck THEN

        bAckSeen := TRUE;

    END_IF;

END_IF;


// State machine
// ============================================================================
CASE eCurrentState OF

    // IDLE
    // ========================================================================
    E_FanucStartProgramState.Idle:

        // Accept Start only when the external rising edge
        // occurs while the robot is already Ready.
        IF rtStart.Q AND bReady THEN

            // RSR supports program selections 1..8.
            IF (nProgram < 1) OR (nProgram > 8) THEN

                eCurrentState := E_FanucStartProgramState.Error;

            ELSE

                // Latch program selection.
                nActiveProgram := nProgram;

                // Start a completely new acknowledgement cycle.
                bAckArmed := FALSE;
                bAckSeen  := FALSE;

                eCurrentState := E_FanucStartProgramState.Pulsing;

            END_IF;

        END_IF;



    // PULSING
    // ========================================================================
    E_FanucStartProgramState.Pulsing:

        // Robot must remain Ready during the start request.
        IF NOT bReady THEN

            eCurrentState := E_FanucStartProgramState.Idle;

        // Always complete the configured RSR pulse.
        ELSIF tonProgramPulse.Q THEN

            // If FANUC already acknowledged during the pulse,
            // the request is complete.
            IF bAckSeen THEN

                eCurrentState := E_FanucStartProgramState.Done;

            ELSE

                // Pulse finished but no ACK yet.
                eCurrentState := E_FanucStartProgramState.WaitAck;

            END_IF;

        END_IF;



    // WAIT ACK
    // ========================================================================
    E_FanucStartProgramState.WaitAck:

        // Abort the FB sequence if Ready is lost.
        IF NOT bReady THEN

            eCurrentState := E_FanucStartProgramState.Idle;

        // Matching FANUC ACK received.
        ELSIF bAckSeen THEN

            eCurrentState := E_FanucStartProgramState.Done;

        // FANUC failed to acknowledge the request in time.
        ELSIF tonAckTimeout.Q THEN

            eCurrentState := E_FanucStartProgramState.Error;

        END_IF;


    // DONE
    // ========================================================================
    E_FanucStartProgramState.Done:

        // bDone is exposed for one PLC scan.
        eCurrentState := E_FanucStartProgramState.Idle;


    // ERROR
    // ========================================================================
    E_FanucStartProgramState.Error:

        // Require Start to be released before another attempt.
        IF NOT bStart THEN

            eCurrentState := E_FanucStartProgramState.Idle;

        END_IF;


    // INVALID / UNKNOWN STATE
    // ========================================================================
    ELSE

        eCurrentState := E_FanucStartProgramState.Error;

END_CASE;


// Timers
// ============================================================================
//
// Each timer is enabled only by its corresponding state.

tonProgramPulse(
    IN := (eCurrentState = E_FanucStartProgramState.Pulsing),
    PT := tProgramPulse);


tonAckTimeout(
    IN := (eCurrentState = E_FanucStartProgramState.WaitAck),
    PT := tAckTimeout);


// Clear internal handshake state while Idle
// ============================================================================
// Once no program-start sequence is active, forget the previous
// acknowledgement state.

IF eCurrentState = E_FanucStartProgramState.Idle THEN

    bAckArmed := FALSE;
    bAckSeen  := FALSE;

END_IF;


// FANUC RSR control outputs
// ============================================================================
// Default all RSR signals FALSE.
//
// This guarantees one-hot behavior and ensures all outputs are removed
// immediately whenever the FB leaves Pulsing.

stControl.Start_Program1 := FALSE;
stControl.Start_Program2 := FALSE;
stControl.Start_Program3 := FALSE;
stControl.Start_Program4 := FALSE;
stControl.Start_Program5 := FALSE;
stControl.Start_Program6 := FALSE;
stControl.Start_Program7 := FALSE;
stControl.Start_Program8 := FALSE;



// Assert selected RSR signal
// ============================================================================
// Exactly one RSR signal is asserted while Pulsing.

IF (eCurrentState = E_FanucStartProgramState.Pulsing) AND NOT tonProgramPulse.Q THEN

    CASE nActiveProgram OF

        1:stControl.Start_Program1 := TRUE;
        2:stControl.Start_Program2 := TRUE;
        3:stControl.Start_Program3 := TRUE;
        4:stControl.Start_Program4 := TRUE;
        5:stControl.Start_Program5 := TRUE;
        6:stControl.Start_Program6 := TRUE;
        7:stControl.Start_Program7 := TRUE;
        8:stControl.Start_Program8 := TRUE;

    END_CASE;

END_IF;



// Diagnostic outputs
// ============================================================================

eState := eCurrentState;

// Busy while transmitting the RSR command or waiting for ACK.
bRequestActive := (eCurrentState = E_FanucStartProgramState.Pulsing) OR (eCurrentState = E_FanucStartProgramState.WaitAck);

// Done is TRUE for exactly one PLC scan after a valid ACK.
bDone := (eCurrentState = E_FanucStartProgramState.Done);

// Error remains TRUE until bStart is released.
bError := (eCurrentState = E_FanucStartProgramState.Error);]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>