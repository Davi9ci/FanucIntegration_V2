<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_FanucCycleStop" Id="{d5a33dbe-22de-9816-1841-daac460200c0}" SpecialFunc="None">
    <Declaration><![CDATA[// Sends the FANUC Cycle Stop command using CSTOPI (UI[4]).
//
// A rising edge of bStart generates a CSTOPI pulse for
// tCycleStopPulse.
//
// The actual FANUC behavior depends on the controller setting
// "CSTOPI for ABORT":
//
// DISABLE:
//     Programs waiting in the RSR queue are cleared.
//     The currently running program continues until completion.
//
// ENABLE:
//     Programs waiting in the RSR queue are cleared.
//     The currently running program is immediately aborted.
//
// This setting is configured in the FANUC controller and cannot
// be selected through this function block.
//
// No acknowledgement is available for CSTOPI. Therefore, bDone
// indicates that the output pulse was transmitted—not that robot
// motion has stopped.

FUNCTION_BLOCK FB_FanucCycleStop

VAR_INPUT
    // External Cycle Stop request.
    // Only a real FALSE -> TRUE edge is accepted.
    bStart : BOOL;

    // Duration for which CSTOPI is asserted.
    tCycleStopPulse : TIME := T#20MS;
END_VAR

VAR_IN_OUT
    // Shared FANUC control structure.
    stControl : ST_FanucControl;
END_VAR

VAR_OUTPUT
    // TRUE while CSTOPI is being asserted.
    bBusy : BOOL;

    // TRUE for one PLC scan after the CSTOPI pulse completes.
    bDone : BOOL;

    // Current state for diagnostics / HMI.
    eState : E_FanucCstopiState;
END_VAR

VAR
    // Internal state.
    eCurrentState : E_FanucCstopiState :=
        E_FanucCstopiState.Idle;

    // Detect the actual FALSE -> TRUE transition.
    rtStart : R_TRIG;

    // CSTOPI output pulse timer.
    tonCycleStopPulse : TON;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// Start edge detection
// ============================================================================
rtStart(CLK := bStart);

// State machine
// ============================================================================
CASE eCurrentState OF

    // IDLE
    // ========================================================================
    E_FanucCstopiState.Idle:

        IF rtStart.Q THEN
            eCurrentState := E_FanucCstopiState.Pulsing;
        END_IF;

    // PULSING
    // ========================================================================
    E_FanucCstopiState.Pulsing:

        IF tonCycleStopPulse.Q THEN
            eCurrentState := E_FanucCstopiState.Done;
        END_IF;

    // DONE
    // ========================================================================
    E_FanucCstopiState.Done:

        // bDone is exposed for one PLC scan.
        eCurrentState := E_FanucCstopiState.Idle;

    // INVALID / UNKNOWN STATE
    // ========================================================================
    ELSE

        // Cycle Stop has no error-recovery sequence.
        // Return safely to Idle and remove CSTOPI.
        eCurrentState := E_FanucCstopiState.Idle;

END_CASE;

// Cycle Stop pulse timer
// ============================================================================
// The timer is called exactly once per PLC scan.

tonCycleStopPulse(
    IN := (eCurrentState = E_FanucCstopiState.Pulsing),
    PT := tCycleStopPulse
);

// FANUC control output
// ============================================================================
// CSTOPI is asserted only while the pulse is active.

stControl.Cycle_stop :=
    (eCurrentState = E_FanucCstopiState.Pulsing)
    AND NOT tonCycleStopPulse.Q;

// Diagnostic outputs
// ============================================================================
eState := eCurrentState;
bBusy := (eCurrentState = E_FanucCstopiState.Pulsing);
bDone := (eCurrentState = E_FanucCstopiState.Done);]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>