<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FB_FanucCycleStop" Id="{d5a33dbe-22de-9816-1841-daac460200c0}" SpecialFunc="None">
    <Declaration><![CDATA[// Pulses CSTOPI; the FANUC "CSTOPI for ABORT" setting determines its effect.
// Completion confirms the output pulse only; no robot acknowledgement is checked.

FUNCTION_BLOCK FB_FanucCycleStop

VAR_INPUT
	bStart			: BOOL; // Rising edge starts a Cycle Stop request while Idle.
	tCycleStopPulse	: TIME := T#20MS; // Requested duration of the CSTOPI output pulse on UI[4].
END_VAR

VAR_IN_OUT
	stControl	: ST_FanucControl; // Shared FANUC control structure; this FB writes Cycle_stop only.
END_VAR

VAR_OUTPUT
	bBusy	: BOOL; // TRUE while the sequence is in Pulsing.
	bDone	: BOOL; // TRUE for one PLC scan after the pulse completes; does not confirm stopped motion.
	eState	: E_FanucCstopiState; // Current state exposed for diagnostics and HMI.
END_VAR

VAR
	eCurrentState		: E_FanucCstopiState := E_FanucCstopiState.Idle; // Internal state used by the sequence.
	rtStart				: R_TRIG; // Detects the FALSE-to-TRUE transition of bStart.
	tonCycleStopPulse	: TON; // Measures the CSTOPI pulse duration in Pulsing.
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// Start edge detection
// ============================================================================
rtStart(CLK := bStart);

// State machine
// ============================================================================
CASE eCurrentState OF

    // IDLE
    // ========================================================================
    E_FanucCstopiState.Idle:

        IF rtStart.Q THEN
            eCurrentState := E_FanucCstopiState.Pulsing;
        END_IF;

    // PULSING
    // ========================================================================
    E_FanucCstopiState.Pulsing:

        IF tonCycleStopPulse.Q THEN
            eCurrentState := E_FanucCstopiState.Done;
        END_IF;

    // DONE
    // ========================================================================
    E_FanucCstopiState.Done:

        // bDone is exposed for one PLC scan.
        eCurrentState := E_FanucCstopiState.Idle;

    // INVALID / UNKNOWN STATE
    // ========================================================================
    ELSE

        // Cycle Stop has no error-recovery sequence.
        // Return safely to Idle and remove CSTOPI.
        eCurrentState := E_FanucCstopiState.Idle;

END_CASE;

// Cycle Stop pulse timer
// ============================================================================
// The timer is called exactly once per PLC scan.

tonCycleStopPulse(
    IN := (eCurrentState = E_FanucCstopiState.Pulsing),
    PT := tCycleStopPulse
);

// FANUC control output
// ============================================================================
// CSTOPI is asserted only while the pulse is active.

stControl.Cycle_stop :=
    (eCurrentState = E_FanucCstopiState.Pulsing) AND NOT tonCycleStopPulse.Q;

// Diagnostic outputs
// ============================================================================
eState := eCurrentState;

bBusy := (eCurrentState = E_FanucCstopiState.Pulsing);

bDone := (eCurrentState = E_FanucCstopiState.Done);]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>